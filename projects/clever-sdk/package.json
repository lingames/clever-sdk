{
    "name": "@lingames/clever-sdk",
    "version": "0.1.37",
    "description": "Clever SDK",
    "main": "./dist/CleverSDK.js",
    "module": "./dist/CleverSDK.mjs",
    "types": "./dist/CleverSDK.d.ts",
    "files": [
        "dist",
        "native",
        "src"
    ],
    "exports": {
        ".": {
            "require": "./dist/CleverSDK.js",
            "import": "./dist/CleverSDK.mjs",
            "types": "./dist/CleverSDK.d.ts",
            "default": "./dist/CleverSDK.js"
        },
        "./models": {
            "types": "./src/models/index.ts"
        }
    },
    "scripts": {
        "clean": "rimraf dist",
        "prepublish": "pnpm run build",
        "build": "pnpm run clean && rollup -c rollup.config.mjs",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org/"
    },
    "devDependencies": {
        "@rollup/plugin-node-resolve": "^16.0.3",
        "@rollup/plugin-terser": "^1.0.0",
        "@rollup/plugin-typescript": "^12.3.0",
        "axios": "^1.18.1",
        "jssha": "^3.3.2",
        "rimraf": "^6.1.3",
        "rollup": "^4.62.2",
        "rollup-plugin-dts": "^6.4.1",
        "tslib": "^2.8.1",
        "typescript": "^6.0.3",
        "vitest": "^4.1.9"
    }
}
